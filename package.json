{
  "name": "site-v2",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "quality": "node scripts/site-quality.mjs",
    "data:generate": "node scripts/generate-database.mjs",
    "digest": "node scripts/generate-weekly-digest.mjs",
    "prebuild": "npm run data:generate",
    "verify": "npm run test && npm run quality && npm run lint && npm run typecheck && npm run build"
  },
  "dependencies": {
    "next": "16.3.2",
    "next-sitemap": "^4.2.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sanitize-html": "^2.17.7",
    "sql.js": "^1.14.2"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@types/sanitize-html": "^2.16.1",
    "eslint": "^9.39.2",
    "eslint-config-next": "16.3.2",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  },
  "overrides": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5"
  }
}
